{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noResolve": true
  },
  "include": [
    "src/preload/**/*.js",
    "src/main/ipc/**/*.js",
    "src/main/flaky/**/*.js",
    "src/main/remote/**/*.js",
    "src/main/backlog/**/*.js",
    "src/main/bugdex/**/*.js",
    "src/main/depwatch/**/*.js",
    "src/main/tank/**/*.js",
    "src/main/stickers/**/*.js",
    "src/main/usage/**/*.js",
    "src/main/weather/**/*.js",
    "src/main/hooks/**/*.js",
    "src/main/claude/**/*.js",
    "src/main/routines/**/*.js",
    "src/main/session/**/*.js",
    "src/main/progression/**/*.js",
    "src/main/worktrees/**/*.js",
    "src/main/history/**/*.js",
    "src/main/sync/**/*.js",
    "src/main/timetrack/**/*.js",
    "src/main/channels/**/*.js",
    "src/main/desktop/**/*.js",
    "node_modules/@types/node/**/*.d.ts",
    "node_modules/electron/electron.d.ts"
  ]
}
