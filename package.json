{
  "name": "shellby",
  "productName": "Shellby",
  "version": "0.25.0",
  "description": "A pixel hermit crab that lives on your Windows desktop and runs Claude Code tasks for you, on your own Claude subscription.",
  "main": "src/main/main.js",
  "author": "x-salmon",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/x-salmon/shellby",
  "repository": {
    "type": "git",
    "url": "https://github.com/x-salmon/shellby.git"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "windows",
    "ai-agent"
  ],
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=120000 \"test/*.test.js\"",
    "lint": "eslint .",
    "e2e:ci": "node scripts/e2e-ci.js",
    "packs": "node scripts/validate-packs.js",
    "packs:format": "node scripts/format-packs.js",
    "packs:sheet": "python scripts/preview-packs.py",
    "icons": "python scripts/make-icons.py",
    "screenshots": "electron . --capture-screenshots",
    "reel": "electron . --capture-screenshots --reel && python scripts/make-reel.py",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0"
  },
  "build": {
    "appId": "com.xsalmon.shellby",
    "productName": "Shellby",
    "copyright": "Copyright (c) 2026 x-salmon",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "protocols": [
      {
        "name": "Shellby",
        "schemes": [
          "shellby"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Shellby-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Shellby-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "x-salmon",
        "repo": "shellby",
        "releaseType": "draft"
      }
    ]
  }
}
