{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x-salmon/shellby/blob/main/docs/addon.schema.json",
  "title": "Shellby wardrobe pack",
  "description": "A data-only pack of accessories, effects, skins, voices, scenes and tank decor for Shellby (format 1). See docs/ADDONS.md. The app strips unknown fields and skips invalid items; this schema is the strict version used to validate uploads.",
  "type": "object",
  "required": ["format", "id", "name", "author", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
    "name": { "$ref": "#/$defs/text", "maxLength": 60 },
    "author": { "$ref": "#/$defs/text", "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "maxLength": 240 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://\\S+$", "maxLength": 200 },
    "accessories": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/accessory" } },
    "effects": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/effect" } },
    "skins": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/skin" } },
    "voices": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/voice" } },
    "scenes": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/scene" } },
    "decor": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/decor" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "itemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "rarity": { "enum": ["common", "rare", "epic", "legendary"] },
    "palette": {
      "description": "One character → one #rrggbb colour. '.' is reserved for transparency.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": { "minLength": 1, "maxLength": 1, "not": { "const": "." } },
      "additionalProperties": { "$ref": "#/$defs/hex" }
    },
    "pixels16": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "string", "maxLength": 16 }
    },
    "pixels32": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "maxLength": 32 }
    },
    "pixels8": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "maxLength": 8 }
    },
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
      "items": false
    },
    "pivot": {
      "$ref": "#/$defs/point",
      "prefixItems": [
        { "type": "integer", "minimum": -16, "maximum": 32 },
        { "type": "integer", "minimum": -16, "maximum": 32 }
      ]
    },
    "anchorPoint": {
      "$ref": "#/$defs/point",
      "prefixItems": [
        { "type": "integer", "minimum": -16, "maximum": 48 },
        { "type": "integer", "minimum": -16, "maximum": 48 }
      ]
    },
    "unlock": {
      "description": "How the item is earned. Omit for always available.",
      "oneOf": [
        {
          "type": "object", "required": ["default"], "additionalProperties": false,
          "properties": { "default": { "const": true } }
        },
        {
          "type": "object", "required": ["achievement"], "additionalProperties": false,
          "properties": {
            "achievement": {
              "enum": ["first-task", "ten-tasks", "quarter-century", "centurion", "crew-boss", "all-hands", "fleet", "toolmaker", "inventor", "tinkerer", "clockwork", "night-owl", "early-bird", "multitasker", "careful", "planner", "special-delivery", "loyal", "check-up", "keep-your-cool", "show-off", "spring-cleaning", "good-crab", "frequent-flyer", "deep-focus", "open-house", "pen-pals", "green-light", "window-sill", "hang-on", "rodeo", "leap-of-faith", "trapeze", "spider-crab", "sticky-feet", "little-gremlin", "tagged", "sticker-bomb", "shiny", "liftoff", "well-traveled", "swap-meet", "beachcomber", "magpie", "curator", "x-marks", "best-friends", "peekaboo", "good-arm", "player-two", "on-air", "storyteller", "gossip", "snack-time", "well-fed", "squeaky-clean", "night-night", "golden-tummy", "launch-day", "back-to-green", "ghostbuster", "critical-hit", "natural-twenty", "clean-landing", "issue-to-ship", "clean-bill", "tidy-shell", "fresh-start", "on-a-roll", "unstoppable", "double-digits", "moving-in", "interior-designer", "house-guest", "aquascaper", "on-display", "upsized", "night-light", "gotcha", "field-notes", "naturalist", "fix-em-all", "exterminator", "golden-touch", "ghost-whisperer", "heisenberg", "harvest-home", "the-haunted", "snowed-in", "pen-pals-forever", "spick-and-span", "beachcombed", "tide-turner", "glimmer", "shiny-hunter", "dazzled", "proud-parent", "big-clutch", "hatchling", "fair-trade", "missing-piece", "top-crab"]
            }
          }
        },
        {
          "type": "object", "required": ["season"], "additionalProperties": false,
          "properties": {
            "season": { "enum": ["halloween", "winter", "valentine", "spring", "summer", "autumn"] }
          }
        }
      ]
    },
    "accessory": {
      "type": "object",
      "required": ["id", "name", "slot", "pivot", "palette", "pixels"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "$ref": "#/$defs/text", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 160 },
        "slot": { "enum": ["hat", "face", "neck", "held", "shell"] },
        "anchor": { "enum": ["head", "face", "neck", "claw", "shellTop"] },
        "follows": { "enum": ["stalks", "body", "claw", "shell", "eyes", "legs"] },
        "pivot": { "$ref": "#/$defs/pivot" },
        "palette": { "$ref": "#/$defs/palette" },
        "pixels": { "$ref": "#/$defs/pixels16" },
        "rarity": { "$ref": "#/$defs/rarity" },
        "unlock": { "$ref": "#/$defs/unlock" }
      }
    },
    "sprite": {
      "type": "object",
      "required": ["palette", "pixels"],
      "additionalProperties": false,
      "properties": {
        "palette": { "$ref": "#/$defs/palette" },
        "pixels": { "$ref": "#/$defs/pixels8" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["id", "name", "motion", "sprites"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "$ref": "#/$defs/text", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 160 },
        "motion": { "enum": ["fall", "rise", "float", "orbit", "twinkle", "burst"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 24, "default": 10 },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 3, "default": 1 },
        "sprites": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/sprite" } },
        "rarity": { "$ref": "#/$defs/rarity" },
        "unlock": { "$ref": "#/$defs/unlock" }
      }
    },
    "skin": {
      "description": "Same format as docs/SKINS.md, plus optional unlock and anchors.",
      "type": "object",
      "required": ["id", "palette", "pixels"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "type": "string", "maxLength": 40 },
        "author": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 120 },
        "palette": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1, "maxLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/hex" }
        },
        "parts": {
          "type": "object",
          "propertyNames": { "minLength": 1, "maxLength": 1 },
          "additionalProperties": { "enum": ["shell", "body", "claw", "eyes", "stalks", "legs", "extra"] }
        },
        "pixels": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": { "type": "string", "maxLength": 40 }
        },
        "unlock": { "$ref": "#/$defs/unlock" },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "head": { "$ref": "#/$defs/anchorPoint" },
            "face": { "$ref": "#/$defs/anchorPoint" },
            "neck": { "$ref": "#/$defs/anchorPoint" },
            "claw": { "$ref": "#/$defs/anchorPoint" },
            "shellTop": { "$ref": "#/$defs/anchorPoint" }
          }
        }
      }
    },
    "line": {
      "description": "One line in his speech bubble: plain text, at most 24 characters, no control characters or bidi overrides.",
      "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "lines": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/line" } },
    "occasionLines": {
      "description": "Lines by occasion: what he says when it comes up.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "working", "success", "error", "learned", "newTricks", "unlocked", "petted",
          "tests", "passed", "fixed", "merged", "push", "deploy", "bigWrite", "sameFile", "searching", "web", "crew", "longTask", "serverDown",
          "todoDone", "todosAll", "jobDone", "jobFailed", "remembered", "compacted", "skillFirst", "planning",
          "morning", "latenight", "back",
          "gameOver", "callOver", "sheetStretch", "docStretch", "slideStretch", "friday", "weekend", "monday", "tank", "tankNew",
          "found", "memory", "milestone", "idle", "oops",
          "perch", "ride", "shaken", "dropped", "dizzy", "pop", "caught",
          "typingBurst", "typingRecord", "rainStart", "snowStart", "stormStart", "rainStopped",
          "climb", "stuck", "leap", "letgo",
          "pinched", "yanked", "shoved", "noteOff", "note", "behave", "noPrank",
          "peckish", "sandy", "sleepy", "mopey", "fed", "stuffed", "pantryEmpty", "snackEarned", "tide", "rinsed", "tuckedIn", "notSleepy", "cheered"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/lines" }
    },
    "temperament": { "enum": ["chipper", "fussy", "cocky", "sleepy"] },
    "voice": {
      "type": "object",
      "required": ["id", "name", "lines"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "$ref": "#/$defs/text", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 160 },
        "lang": { "description": "The language the lines are in, as a tag like \"es\" or \"pt-BR\".", "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$" },
        "fallback": { "description": "On occasions with no lines here: \"shellby\" uses his own lines, \"quiet\" says nothing.", "enum": ["shellby", "quiet"], "default": "shellby" },
        "lines": { "$ref": "#/$defs/occasionLines" },
        "flavor": {
          "description": "Extra lines for one temperament, added to its lines.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/temperament" },
          "additionalProperties": { "$ref": "#/$defs/occasionLines" }
        },
        "rarity": { "$ref": "#/$defs/rarity" },
        "unlock": { "$ref": "#/$defs/unlock" }
      }
    },
    "sayChoice": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/line" } }] },
    "say": {
      "description": "A line, a list to pick from, or lines by temperament with \"any\" for the rest.",
      "oneOf": [
        { "$ref": "#/$defs/sayChoice" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "any": { "$ref": "#/$defs/sayChoice" },
            "chipper": { "$ref": "#/$defs/sayChoice" },
            "fussy": { "$ref": "#/$defs/sayChoice" },
            "cocky": { "$ref": "#/$defs/sayChoice" },
            "sleepy": { "$ref": "#/$defs/sayChoice" }
          }
        }
      ]
    },
    "beat": {
      "type": "object",
      "required": ["bit", "ms"],
      "additionalProperties": false,
      "properties": {
        "bit": {
          "enum": [
            "dig", "polish", "peek", "stretch", "flop", "squint", "creep", "pounce", "nose", "sneeze", "sniff", "hic", "hold",
            "blow", "nod", "jolt", "curl", "admire", "rock", "bow", "swat", "jab", "gaze", "juggle", "bonk", "present", "lean",
            "sip", "boogie", "hide", "boo", "shiver", "wave", "count"
          ]
        },
        "ms": { "type": "integer", "minimum": 500, "maximum": 5000 },
        "say": { "$ref": "#/$defs/say" },
        "prop": { "enum": ["castle", "castle-fall", "bubbles", "fly", "shooting-star", "juggle", "heart", "achoo", "zz", "notes", "sweat"] },
        "hold": { "enum": ["find", "coffee", "pebble", "mic"] },
        "wear": { "enum": ["shades"] }
      }
    },
    "when": {
      "description": "Conditions that must all hold for the scene to come up.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "night": { "const": true },
        "day": { "const": true },
        "weekend": { "const": true },
        "friday": { "const": true },
        "monday": { "const": true },
        "music": { "const": true },
        "cursor": { "const": true },
        "find": { "const": true },
        "bond": { "type": "integer", "minimum": 1, "maximum": 5 },
        "season": { "enum": ["halloween", "winter", "valentine", "spring", "summer", "autumn"] }
      }
    },
    "scene": {
      "description": "A little scene in beats. The beats can add up to at most 12000 ms.",
      "type": "object",
      "required": ["id", "name", "beats"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "$ref": "#/$defs/text", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 160 },
        "who": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/temperament" } },
        "when": { "$ref": "#/$defs/when" },
        "voice": { "description": "A voice in this pack: the scene only plays while he talks in it.", "$ref": "#/$defs/itemId" },
        "beats": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/beat" } }
      }
    },
    "decor": {
      "description": "A piece of decor for his tank. Substrates and backdrops are tiles the tank repeats, with no layer, frames or spots.",
      "type": "object",
      "required": ["id", "name", "category", "palette", "pixels"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "$ref": "#/$defs/text", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 160 },
        "category": { "enum": ["structure", "plant", "rock", "treasure", "bubbler", "substrate", "backdrop"] },
        "layer": { "enum": ["floor", "back", "float"] },
        "palette": { "$ref": "#/$defs/palette" },
        "pixels": { "$ref": "#/$defs/pixels32" },
        "frames": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/pixels32" } },
        "fps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "spots": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["kind", "at"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["hide", "sit", "climb", "sleep", "nibble", "open", "peek"] },
              "at": { "$ref": "#/$defs/point" }
            }
          }
        },
        "rarity": { "$ref": "#/$defs/rarity" },
        "unlock": { "$ref": "#/$defs/unlock" }
      }
    }
  }
}
